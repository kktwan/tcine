DB_USERNAME=tcine
DB_PASSWORD=강력한_비밀번호
# Cloudflare Turnstile 캡챠 (비우면 캡챠를 쓰지 않음)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Google Gemini API 키 (AI 추천 이유 생성)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Qdrant 접속 키
QDRANT_API_KEY=강력한_무작위_키
# 영화·시리즈 추천: TMDB 키, KOBIS 박스오피스 키, 색인 관리자 아이디
TMDB_API_KEY=
KOBIS_API_KEY=
# 임베딩용 OpenAI 키
OPENAI_API_KEY=
MOVIE_ADMIN=관리자_아이디
# 매일 새벽 4시 신작/인기작 자동 색인 여부
MOVIE_AUTO_INDEX=true
# 매일 새벽 4시 30분 방영 중/신작/인기 시리즈 자동 색인 여부
TV_AUTO_INDEX=true
# HTTPS 적용 시 true, HTTP 테스트 시 false
SESSION_COOKIE_SECURE=false
